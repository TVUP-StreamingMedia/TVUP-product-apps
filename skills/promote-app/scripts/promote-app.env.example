# promote-app.env.example — cópialo a promote-app.env (ignorado por git) y rellena los CAMBIAR
# No contiene secretos. La API key de Anthropic se pasa por variable de entorno.

# --- GitHub ---
ORG="TVUP-StreamingMedia"
TEMPLATE_REPO="TVUP-app-template"      # repo plantilla (marcado como template)
CENTRAL_REPO="TVUP-product-apps"       # repo con el workflow reutilizable de revisión
CENTRAL_TAG="v1"                       # tag al que apunta el workflow de cada app
REVIEW_WORKFLOW_FILE="revision.yml"    # nombre del workflow dentro de cada repo
REQUIRED_CHECK=""                      # opcional: nombre exacto del check a exigir en main

# --- Google Cloud ---
GCP_PROJECT="CAMBIAR"                  # ID del proyecto TVUP App Suite Group
REGION="europe-west1"
CB_REGION=""          # región de la conexión de Cloud Build con GitHub; vacío = REGION (en TVUP: europe-southwest1)
CB_CONNECTION="Github"                 # nombre de la conexión de host de Cloud Build (2ª gen)
CB_SERVICE_ACCOUNT=""                  # obligatorio: la cuenta de mínimo privilegio de setup-build-sa.sh, no la de Compute
RUNTIME_SA=""                          # cuenta con la que se ejecutan las apps (setup-build-sa.sh: tvup-apps-runtime)
SOURCE_BUILD_SA=""                     # cuenta del build interno, projects/P/serviceAccounts/... (tvup-apps-source-build)
DEPLOY_SA=""                           # cuenta del despliegue diario, sin aprobador ni actAs (ADR-0002: tvup-deploy@PROYECTO.iam.gserviceaccount.com)
FIREBASE_PROJECT="CAMBIAR"             # ID del proyecto Firebase estándar de producción
# Config pública del SDK web de ese proyecto (Firebase → Project settings → tu app web).
# No son secretos; el script los escribe en src/lib/firebase-config.ts de cada app.
FIREBASE_API_KEY="CAMBIAR"
FIREBASE_AUTH_DOMAIN="CAMBIAR"
FIREBASE_APP_ID="CAMBIAR"
MICROSOFT_TENANT_ID="CAMBIAR"          # Directory (tenant) ID de Entra ID
DOMINIOS_CORPORATIVOS="tvup.media thechannelstore.tv"   # dominios de correo que pueden entrar, separados por espacios

# --- Dominio ---
ROOT_DOMAIN="tvup.cloud"
APPS_DOMAIN="apps.tvup.cloud"
ROUTE53_ZONE_ID=""                     # opcional; si está vacío se busca por ROOT_DOMAIN

# --- Local ---
WORK_DIR="$HOME/tvup-apps"             # donde se clonan los repos y se guardan los informes
