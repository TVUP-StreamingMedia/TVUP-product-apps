{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["USER", "PRODUCT_TEAM", "ADMIN", "CTO"] },
        "avatar": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Idea": {
      "title": "Idea",
      "description": "A seed/idea proposal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["DRAFT", "PENDING", "REVIEWING", "APPROVED", "REJECTED"] },
        "data": { "type": "object" },
        "votes": { "type": "array" }
      },
      "required": ["id", "userId", "status"]
    },
    "Initiative": {
      "title": "Initiative",
      "description": "An innovation initiative based on an approved seed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seedId": { "type": "string" },
        "createdByUserId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["seedId", "createdByUserId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/ideas/{ideaId}": {
      "schema": "Idea",
      "description": "Seed proposals"
    },
    "/initiatives/{initiativeId}": {
      "schema": "Initiative",
      "description": "Innovation initiatives"
    },
    "/votes/{voteId}": {
      "schema": "object",
      "description": "Votes on ideas"
    }
  }
}
