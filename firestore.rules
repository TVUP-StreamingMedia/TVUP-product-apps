rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "editorial.tvup@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"))
      );
    }

    function isCTO() {
      return isSignedIn() && (
        request.auth.token.email == "cto@tvup.media" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "CTO" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "cto"))
      );
    }

    function isProductTeam() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "PRODUCT_TEAM" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "PRODUCT" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "EDITOR" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "product_team" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "product" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "editor" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    function isValidUser(data) {
      return data.id is string && 
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.role in ['USER', 'PRODUCT_TEAM', 'PRODUCT', 'ADMIN', 'CTO', 'EDITOR', 'user', 'product_team', 'product', 'admin', 'cto', 'editor'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // PII Protection: Only owner or privileged roles can read user profiles
      allow read: if isOwner(userId) || isAdmin() || isProductTeam() || isCTO();
      
      allow create: if isSignedIn() && isValidUser(request.resource.data) && (
        (isOwner(userId) && request.resource.data.role == 'USER') || 
        isAdmin()
      );
      
      allow update: if isSignedIn() && isValidUser(request.resource.data) && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /ideas/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isProductTeam() || 
        isAdmin()
      );
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    match /initiatives/{initiativeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.createdByUserId == request.auth.uid || 
        isAdmin() ||
        isProductTeam() ||
        (isCTO() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['developmentCosts', 'developmentCostsExplanation', 'operationalCosts', 'operationalCostsExplanation', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
